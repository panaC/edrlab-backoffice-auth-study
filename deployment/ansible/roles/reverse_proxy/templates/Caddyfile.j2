{
	admin {{ caddy_admin_api }}
{% if caddy_email | length > 0 %}
	email {{ caddy_email }}
{% endif %}
}

{% for site in caddy_sites %}
{{ site.address }} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}

{% set tls_mode = site.tls_mode | default(caddy_tls_mode) %}
{% if tls_mode == "internal" %}
	tls internal
{% endif %}

	reverse_proxy {{ site.upstream }} {
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Port {server_port}
	}

	log {
		output file /var/log/caddy/access-{{ site.name }}.log {
			roll_size 10MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format json
	}
}

{% endfor %}
